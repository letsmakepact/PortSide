[Unit]
Description=PortSide Primary Multiplexed Reverse Tunnel Relay
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/portside-relay
ExecStart=/opt/portside-relay/portsided-relay -client-addr :7000 -http-addr 127.0.0.1:7080 -base-domain portside.lol
Restart=always
RestartSec=3
LimitNOFILE=65535

# Security hardening
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
